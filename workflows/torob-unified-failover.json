    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://torob-bridge:3001/api/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.TOROB_BRIDGE_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { query: $json.query, max_products: $json.max_products, include_variants: $json.include_variants } }}",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -220,
        -100
      ],
      "id": "8f010001-0000-4000-8000-000000000004",
      "name": "Call Unified MCP Bridge"
    },
    {
      "parameters": {
        "jsCode": "const response = $json ?? {};\nconst body = response.body && typeof response.body === 'object' ? response.body : response;\nconst status = Number(response.statusCode ?? response.status ?? (body.ok === true ? 200 : 502));\nif (status < 200 || status >= 300 || body.ok !== true) {\n  return [{ json: {\n    ok: false,\n    statusCode: status || 502,\n    code: body.code ?? 'BRIDGE_ERROR',\n    error: body.error ?? 'Torob bridge failed',\n    human_review_required: body.human_review_required === true,\n    retry_automatically: false\n  } }];\n}\nif (!Array.isArray(body.rows)) {\n  return [{ json: { ok: false, statusCode: 502, code: 'INVALID_BRIDGE_RESPONSE', error: 'Bridge response has no rows array', retry_automatically: false } }];\n}\nif (body.rows.length === 0) {\n  return [{ json: { ok: true, 'نوع داده': 'وضعیت', 'نام محصول': body.query ?? '', 'برند': '', 'مدل': '', 'شناسه محصول ترب': '', 'نام فروشگاه': '', 'قیمت': null, 'لینک محصول': '', 'لینک فروشگاه': '', 'وضعیت موجودی': 'نتیجه‌ای یافت نشد', 'تاریخ و زمان دریافت اطلاعات': body.retrieved_at ?? new Date().toISOString(), 'توضیحات': 'جست‌وجو با موفقیت انجام شد اما پیشنهاد فروشنده‌ای دریافت نشد' } }];\n}\nreturn body.rows.map(row => ({ json: { ...row } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,

      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst query = String(body.product ?? body.query ?? '').trim();\nconst maxProducts = Number(body.max_products ?? 10);\nif (!query) return [{ json: { ok: false, statusCode: 400, error: 'product یا query الزامی است' } }];\nif (!Number.isInteger(maxProducts) || maxProducts < 1 || maxProducts > 25) return [{ json: { ok: false, statusCode: 400, error: 'max_products باید عدد صحیح بین 1 تا 25 باشد' } }];\nreturn [{ json: { ok: true, query, max_products: maxProducts, include_variants: body.include_variants !== false } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "id": "8f010001-0000-4000-8000-000000000002",

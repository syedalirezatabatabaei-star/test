{
  "name": "Torob AI Agent Browser Extraction - Excel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "torob-ai-extract",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1010001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        -900,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b=$json.body??$json;const query=String(b.product??b.query??'').trim();const max=Number(b.max_products??10);const reviewId=b.review_id?String(b.review_id):undefined;if(!query)return[{json:{ok:false,statusCode:400,error:'product is required'}}];if(!Number.isInteger(max)||max<1||max>20)return[{json:{ok:false,statusCode:400,error:'max_products must be 1..20'}}];return[{json:{ok:true,query,max_products:max,...(reviewId?{review_id:reviewId}:{})}}];"
      },
      "id": "a1010001-0000-4000-8000-000000000002",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1010002-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1010001-0000-4000-8000-000000000003",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://torob-bridge:3001/api/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { query: $json.query, max_products: $json.max_products, ...( $json.review_id ? { review_id: $json.review_id } : {} ) } }}",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": true
            }
          }
        }
      },
      "id": "a1010001-0000-4000-8000-000000000004",
      "name": "Browser Extraction Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -220,
        -100
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Analyze this structured browser extraction result and normalize it for Excel. Do not invent or enrich missing values. Query: '+$('Validate Input').item.json.query+'\\nRaw result: '+JSON.stringify($json) }}",
        "options": {
          "systemMessage": "You normalize extracted product/seller data only. Preserve observed values. Never infer prices or sellers. If challenge_detected or human_review_required is true, return exactly JSON with ok:false and human_review_required:true. Otherwise return JSON {ok:true,products:[...]}. No CAPTCHA bypass instructions."
        }
      },
      "id": "a1010001-0000-4000-8000-000000000005",
      "name": "AI Data Structuring Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "a1010001-0000-4000-8000-000000000006",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        0,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "let v;const raw=$json.output??$json.text??$json;try{v=typeof raw==='object'?raw:JSON.parse(String(raw).replace(/^```json\\s*/,'').replace(/```$/,''));}catch{return[{json:{ok:false,statusCode:502,error:'Invalid AI JSON'}}];}if(v.human_review_required||v.challenge_detected||v.ok===false)return[{json:{ok:false,statusCode:423,code:'HUMAN_REVIEW_REQUIRED',error:v.message??'Torob requires human verification',human_review_required:true,retry_automatically:false}}];if(!Array.isArray(v.products)||!v.products.length)return[{json:{ok:false,statusCode:404,error:'No products extracted'}}];return v.products.map(p=>({json:{'نام محصول':p.product_name??p.title??'','برند':p.brand??'','مدل':p.model??'','نام فروشگاه':p.seller_name??'','قیمت (تومان)':p.price_toman??null,'لینک محصول':p.product_url??'','لینک فروشگاه':p.seller_url??'','موجودی':p.availability??'','شهر':p.city??'','زمان استخراج':new Date().toISOString()}}));"
      },
      "id": "a1010001-0000-4000-8000-000000000007",
      "name": "Normalize Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        -100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "a1010002-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.ok }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1010001-0000-4000-8000-000000000008",
      "name": "Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        500,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "xlsx",
        "options": {
          "fileName": "torob-ai-extraction.xlsx",
          "headerRow": true,
          "sheetName": "Torob"
        },
        "putOutputFileInField": "data"
      },
      "id": "a1010001-0000-4000-8000-000000000009",
      "name": "Create Excel",
      "type": "n8n-nodes-base.convertToFile",

    {
      "parameters": {
        "jsCode": "const b=$json.body??$json;\nconst query=String(b.query??'').trim();\nconst limit=Math.max(1,Math.min(30,Number(b.limit)||30));\nconst page=Math.max(1,Math.min(200,Math.floor(Number(b.page)||1)));\nconst sortMap={relevance:'rank',bestselling:'sales',cheapest:'price',expensive:'pricedesc',newest:'newest'};\nconst sort=sortMap[String(b.sort??'relevance')]??'rank';\nconst num=v=>v==null||v===''?null:Number(v);\nconst minPrice=num(b.min_price),maxPrice=num(b.max_price),categoryId=num(b.category_id);\nconst bool=v=>v===true||v===1||String(v).toLowerCase()==='true';\nconst errors=[];\nif(!query)errors.push('query is required');\nif(minPrice!==null&&(!Number.isFinite(minPrice)||minPrice<0))errors.push('min_price must be a non-negative Toman amount');\nif(maxPrice!==null&&(!Number.isFinite(maxPrice)||maxPrice<0))errors.push('max_price must be a non-negative Toman amount');\nif(minPrice!==null&&maxPrice!==null&&minPrice>maxPrice)errors.push('min_price cannot exceed max_price');\nif(categoryId!==null&&(!Number.isInteger(categoryId)||categoryId<1))errors.push('category_id must be a positive integer');\nif(errors.length)return[{json:{ok:false,statusCode:400,error:errors.join('; ')}}];\nreturn[{json:{ok:true,query,limit,page,sort,min_price:minPrice,max_price:maxPrice,category_id:categoryId,free_shipping:bool(b.free_shipping),has_discount:bool(b.has_discount),top_vendors:bool(b.top_vendors),installments:bool(b.installments),source:'basalam',requested_at:new Date().toISOString()}}];"
      },

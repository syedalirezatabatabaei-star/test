      "id": "bslm0001-0000-4000-8000-000000000005",
      "name": "Search Basalam Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -220,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const input=$('Validate Input').first().json;\nconst response=$json,status=Number(response.statusCode??200);\nif(status>=400)return[{json:{ok:false,statusCode:status,error:'Basalam search returned HTTP '+status+'. Stop on 403/429 and retry later; do not bypass access controls.'}}];\nconst body=response.body??response,products=Array.isArray(body.products)?body.products:[];\nconst toman=v=>{const n=Number(v);return Number.isFinite(n)&&n>0?Math.round(n/10):null};\nconst seen=new Set(),rows=[];\nfor(const p of products){\n const pid=String(p.id??'');if(!pid||seen.has(pid))continue;seen.add(pid);\n const price=Number(p.price),old=Number(p.primaryPrice),vendor=p.vendor??{},rating=p.rating??{};\n const discounted=Number.isFinite(price)&&Number.isFinite(old)&&old>price;\n rows.push({product_id:pid,product_name:String(p.name??'').trim(),price_toman:toman(p.price),original_price_toman:discounted?toman(p.primaryPrice):toman(p.price),discount_percent:discounted?Math.round((1-price/old)*100):0,rating:rating.average??null,rating_count:rating.count??null,in_stock:p.IsAvailable??null,stock:p.stock??null,free_shipping:Boolean(p.isFreeShipping),unit:p.mainAttribute??null,category:p.categoryTitle??null,shop_name:vendor.name??null,shop_identifier:vendor.identifier??null,product_url:'https://basalam.com/p/'+pid,captured_at:new Date().toISOString()});\n}\nif(!rows.length)return[{json:{ok:false,statusCode:422,error:'No products were returned. Try another Persian query, category_id, or page.',query:input.query,page:input.page,total:body.meta?.count??0}}];\nreturn[{json:{ok:true,query:input.query,page:input.page,count:rows.length,total:body.meta?.count??rows.length,rows}}];"
      },
